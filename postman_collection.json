      "item": [
        {
          "name": "Inscription (Register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation {\n  register(input: {\n    email: \"admin@traffic.com\",\n    password: \"password123\",\n    firstName: \"Admin\",\n    lastName: \"User\",\n    role: ADMIN\n  }) {\n    accessToken\n    user {\n      id\n      email\n      role\n      firstName\n      lastName\n      createdAt\n    }\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "http://localhost:3001/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["graphql"]
            },
            "description": "Créer un nouveau compte utilisateur avec le rôle ADMIN ou OPERATOR"
          },
          "response": []
        },
        {
          "name": "Connexion (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.login) {",
                  "    pm.collectionVariables.set('token', jsonData.data.login.accessToken);",
                  "    pm.collectionVariables.set('user_id', jsonData.data.login.user.id);",
                  "    console.log('Token sauvegardé:', jsonData.data.login.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation {\n  login(input: {\n    email: \"admin@traffic.com\",\n    password: \"password123\"\n  }) {\n    accessToken\n    user {\n      id\n      email\n      role\n      firstName\n      lastName\n    }\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "http://localhost:3001/graphql",
